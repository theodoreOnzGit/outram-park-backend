#!/usr/bin/env bash
# OUTRAM PARK token-accounting hook (standing rule): stamp every commit message
# with an API-Usage trailer derived from the Claude Code session transcripts.
# Never blocks a commit — the Python script degrades to a zero/"source=none"
# trailer if no usage data is available. See docs/historian/token_usage.py.
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
python3 "$ROOT/docs/historian/token_usage.py" trailer "$1" || true
exit 0
