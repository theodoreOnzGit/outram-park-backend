#!/usr/bin/env bash
# OUTRAM PARK token-accounting hook (standing rule): after each commit, advance
# the per-commit token baseline and regenerate docs/token-usage.md from the
# commit-message trailers. Never blocks.
# See crates/kovan-metrics (this replaced docs/historian/token_usage.py).
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# shellcheck source=/dev/null
. "$ROOT/.githooks/kovan-bin.sh" 2>/dev/null || exit 0
[ -n "${KOVAN_BIN:-}" ] || exit 0
"$KOVAN_BIN" tokens record || true
exit 0
