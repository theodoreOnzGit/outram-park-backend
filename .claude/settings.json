{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bn prime --mcp",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./scripts/push-beads-store.sh",
            "type": "command",
            "timeout": 30,
            "statusMessage": "Publishing beads store ref"
          }
        ],
        "matcher": ""
      }
    ]
  }
}