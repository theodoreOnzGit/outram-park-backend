# gh:#1415 multisphere cross-code deck (generated by make_multisphere_decks.sh; see
# crates/outram-park-fork-liggghts/docs/verification-and-validation.md, section 4.16).
atom_style	granular
atom_modify	map array sort 0 0
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.05 0.05 -0.05 0.05 -0.005 0.15 units box
create_box	2 reg
neighbor	0.002 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 1.0e7 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 2 0.4 0.4 0.4 0.4
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	1e-5
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		pts1 all particletemplate/multisphere 15485863 atom_type 1 density constant 2500 nspheres 3 ntry 100000 spheres file ms_clump1.txt scale 0.0011 type 1
fix		pdd1 all particledistribution/discrete 15485867 1 pts1 1.0
region		ins block -0.01 0.01 -0.01 0.01 0.03 0.05 units box
fix		ins all insert/pack seed 32452843 distributiontemplate pdd1 insert_every once overlapcheck yes all_in yes vel constant 0.1 0. -0.5 omega constant 3. -2. 5. orientation constant 0.5 0.5 0.5 0.5 region ins particles_in_region 1
fix		ms all multisphere
thermo_style	custom step atoms
thermo		1000
thermo_modify	lost ignore norm no
run 1
write_dump all custom dump.F1 id x y z vx vy vz omegax omegay omegaz modify sort id
run 999 pre no
write_dump all custom dump.F1000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 3000 pre no
write_dump all custom dump.F4000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1000 pre no
write_dump all custom dump.F5000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1000 pre no
write_dump all custom dump.F6000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F8000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F10000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F12000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 3000 pre no
write_dump all custom dump.F15000 id x y z vx vy vz omegax omegay omegaz modify sort id
