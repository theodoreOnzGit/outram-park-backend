# fix check/timestep/gran on the settled bed (gh:#1406 prio 2): prints the
# Rayleigh and Hertz step fractions for comparison with timestep.rs.
# Needs timestep_htr10.data = csv2data.sh htr10_settled.csv timestep_htr10.data 0.06 1730 -0.70 6.00
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.018 bin
neigh_modify	delay 0
read_data	timestep_htr10.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e8
fix 		m2 all property/global poissonsRatio peratomtype 0.2
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	3.5e-5
fix		ts all check/timestep/gran 1 0.1 0.1 warn no
fix		integr all nve/sphere
thermo_style	custom step f_ts[1] f_ts[2] f_ts[3]
thermo_modify	format float %.17g
thermo		1
run		1
