# fix heat/gran/conduction on the settled D/d = 6 bed (gh:#1412): 354 pebbles,
# cylinder + floor + gravity as in.pgl_pebble, k = 50 W/m/K, cp = 10 J/kg/K
# (small cp magnifies the temperature change in the 100 steps run), initial
# T = 300 + 200 z/0.35 K per pebble; dumps T and heatFlux at every step.
# Needs heat_bed.data = csv2data.sh pebble_bed_settled.csv heat_bed.data 0.01 2500 -0.005 0.35
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	heat_bed.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
fix 		ftco all property/global thermalConductivity peratomtype 50.
fix 		ftca all property/global thermalCapacity peratomtype 10.
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		heat all heat/gran/conduction initial_temperature 300.
fix		integr all nve/sphere
run		0
variable	tt atom 300.0+200.0*z/0.35
set		group all property/atom Temp v_tt
dump		d1 all custom 1 dump.heat_bed id f_heat f_heatFlux
dump_modify	d1 sort id
thermo		50
thermo_modify	lost ignore norm no
run		100
