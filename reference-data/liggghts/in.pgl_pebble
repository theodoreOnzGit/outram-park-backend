# compute pair/gran/local dump (gh:#1418, gh:#1406 prio 2): per-contact force,
# torque, overlap and shear history of the settled D/d = 6 bed (354 pebbles)
# at steps 1..100, for comparison with GranularSystem::pair_gran_local.
# Needs pgl_pebble.data = csv2data.sh pebble_bed_settled.csv pgl_pebble.data 0.01 2500 -0.005 0.35
# Both codes start from the same settled configuration; the bed is under
# gravity with the cylinder and floor of in.pebble_bed.
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	pgl_pebble.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
compute		pgl all pair/gran/local pos vel id force torque history contactArea delta
dump		d1 all local 1 dump.pgl.* c_pgl[1] c_pgl[2] c_pgl[3] c_pgl[4] c_pgl[5] c_pgl[6] c_pgl[7] c_pgl[8] c_pgl[9] c_pgl[10] c_pgl[11] c_pgl[12] c_pgl[13] c_pgl[14] c_pgl[15] c_pgl[16] c_pgl[17] c_pgl[18] c_pgl[19] c_pgl[20] c_pgl[21] c_pgl[22] c_pgl[23] c_pgl[24] c_pgl[25] c_pgl[26] 
dump_modify	d1 format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g "
thermo		50
thermo_modify	lost ignore norm no
run		100
