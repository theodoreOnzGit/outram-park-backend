# Friction ablation on the D/d = 6 bed (gh:#1406 prio 2, V&V 4.9 cells, run in BOTH codes):
# the 354-pebble bed as inserted (pebble_bed_init.csv) settled for 400 000 steps
# at the friction cell given by -var MU <mu> -var MUR <mu_r> (mu_r = 0 runs
# WITHOUT a rolling model, as the port's mu_r = 0 cells do; mu_r > 0 uses CDT).
# Needs ablate.data = csv2data.sh pebble_bed_init.csv ablate.data 0.01 2500 -0.005 0.35
# Run: lmp_serial -var MU 0.1 -var MUR 0.0 -in in.ablate   (then in.ablate_cdt for MUR > 0)
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	ablate.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 ${MU}
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
dump		d1 all custom 50000 dump.ablate id x y z vx vy vz omegax omegay omegaz
dump_modify	d1 sort id
thermo		50000
thermo_modify	lost ignore norm no
run		400000
