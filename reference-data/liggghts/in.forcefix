# fix addforce (constant x/y + equal-style variable z), fix viscous and fix freeze on a group
# (gh:#1418), on the 354-pebble D/d = 6 bed as inserted (pebble_bed_init.csv), with the
# cylinder + floor walls and gravity declared BEFORE the three fixes (post_force order).
# Needs forcefix.data = csv2data.sh pebble_bed_init.csv forcefix.data 0.01 2500 -0.005 0.35
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	forcefix.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
group		fr id <= 30
group		pw id 31:200
variable	fz equal 0.002*sin(step*dt*3000.0)-0.001
fix		af pw addforce 0.0005 -0.0003 v_fz
fix		vis all viscous 0.002
fix		frz fr freeze
fix		integr all nve/sphere
dump		d1 all custom 100 dump.forcefix id x y z vx vy vz omegax omegay omegaz
dump_modify	d1 sort id
thermo_style	custom step ke
thermo_modify	format float %.17g
thermo		100
thermo_modify	lost ignore norm no
run		2000
