# HTR-10 bottom conus + discharge tube: the settled core bed slumps into the
# defuelling geometry.
#
# WHY THIS CASE EXISTS. The cross-code comparison to date covers the core as a
# flat-floored cylinder. The recirculation work replaces that floor with the
# published conus and fuel discharge tube, read from a triangulated mesh, and a
# valve plane at the tube bottom. That is new geometry and a new contact path
# (mesh wall, not primitive), so it needs its own cross-code check before any
# conclusion is drawn from a run that uses it.
#
# Both codes start from the IDENTICAL configuration -- htr10_settled.csv, this
# deck's own settled output from in.htr10 -- converted by csv2data.sh. Neither
# code re-inserts, so nothing depends on reproducing an RNG stream.
#
# Geometry, from docs/reactor-scoping/htr10-neutronics.md:
#     core radius          90 cm
#     conus height     36.946 cm
#     discharge tube R     25 cm     (tube shortened to 25 cm; see the Rust case)
#     valve plane       z = -0.61946 m
# The mesh is htr10_discharge.stl, 480 facets, generated by
# make_htr10_discharge_stl.sh beside it, and is read by BOTH codes.
#
# Material is the HTR-10 design point at the raised stiffness the settling case
# established: E = 5e8 Pa, nu = 0.2, e = 0.5, mu = 0.4, mu_r = 0.1 (CDT).
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.018 bin
neigh_modify	delay 0
read_data	htr10_settled.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e8
fix 		m2 all property/global poissonsRatio peratomtype 0.2
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.4
fix 		m5 all property/global coefficientRollingFriction peratomtypepair 1 0.1
pair_style	gran model hertz tangential history rolling_friction cdt
pair_coeff	* *
timestep	3.5e-5
# The core barrel. NOTE: no zplane at z = 0 -- the flat floor is deliberately
# gone, which is the whole point of the case; the bed now rests on the conus.
fix		cyl all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zcylinder 0.90 0. 0.
# The defuelling valve at the bottom of the discharge tube.
fix		valve all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane -0.61946
# The conus + tube as a triangulated wall -- the same STL the Rust port reads.
fix		conemesh all mesh/surface file htr10_discharge.stl type 1
fix		conewall all wall/gran model hertz tangential history rolling_friction cdt mesh n_meshes 1 meshes conemesh
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
compute		ketrans all ke
thermo_style	custom step atoms ke
thermo		1000
thermo_modify	lost ignore norm no
# Dump the trajectory, not just the endpoint, so the two codes can be compared
# throughout the slump rather than only where it ends.
dump		d1 all custom 2000 dump.htr10_conus id x y z vx vy vz
dump_modify	d1 sort id
run		20000
undump		d1
write_dump	all custom dump.htr10_conus_settled id x y z vx vy vz modify sort id
variable	kef equal ke
print		"CONUS_FINAL_KE ${kef}"
