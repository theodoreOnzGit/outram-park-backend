atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.12 0.12 -0.12 0.12 -0.12 0.12 units box
create_box	1 reg
neighbor	0.003 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	1e-5
fix		drum all mesh/surface file drum_cylinder.stl type 1
fix		pwall all wall/gran model hertz tangential history mesh n_meshes 1 meshes drum
create_atoms	1 single 0.0 0.0 -0.0440 units box
create_atoms	1 single 0.009 0.004 -0.0435 units box
set		atom * diameter 0.008 density 2500
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
fix		spin all move/mesh mesh drum rotate origin 0. 0. 0. axis 0. 1. 0. period 0.5
thermo		1000
thermo_modify	lost ignore norm no
dump		d1 all custom 80 dump.rotating_drum id x y z vx vy vz omegax omegay omegaz fx fy fz
run		20000
