# As in.ablate with CDT rolling friction coefficient MUR (gh:#1406 prio 2).
# Run: lmp_serial -var MU 0.4 -var MUR 0.1 -in in.ablate_cdt
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	ablate.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 ${MU}
fix 		m5 all property/global coefficientRollingFriction peratomtypepair 1 ${MUR}
pair_style	gran model hertz tangential history rolling_friction cdt
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
dump		d1 all custom 50000 dump.ablate id x y z vx vy vz omegax omegay omegaz
dump_modify	d1 sort id
thermo		50000
thermo_modify	lost ignore norm no
run		400000
