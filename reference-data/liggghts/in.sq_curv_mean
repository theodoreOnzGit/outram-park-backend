# gh:#1415 superquadric cross-code deck (generated by make_superquadric_decks.sh; see
# crates/outram-park-fork-liggghts/docs/verification-and-validation.md, section 4.17).
atom_style	superquadric
atom_modify	map array sort 0 0
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.05 0.05 -0.05 0.05 -0.005 0.15 units box
create_box	1 reg
neighbor	0.002 bin
neigh_modify	delay 0 every 1 check no
fix 		m1 all property/global youngsModulus peratomtype 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.4
pair_style	gran model hertz tangential history surface superquadric curvatureLimitFactor 1.5 meanCurvature yes
pair_coeff	* *
timestep	1e-5
fix		zwall all wall/gran model hertz tangential history surface superquadric primitive type 1 zplane 0.04 curvatureLimitFactor 1.5 meanCurvature yes
fix		grav all gravity 9.81 vector 0 0 -1
create_atoms	1 single -0.006 0.0 0.05 units box
create_atoms	1 single 0.006 0.0015 0.051 units box
set		atom 1 shape 0.004 0.003 0.0025 blockiness 6 6 density 2500 quat_direct 0.9 0.3 0.2 0.1
set		atom 2 shape 0.0035 0.003 0.004 blockiness 4 3 density 1500 quat_direct 0.7 -0.2 0.5 0.4
set		atom 1 vx 0.4 vy 0. vz 0. omegax 0. omegay 4. omegaz 0.
set		atom 2 vx -0.4 vy 0. vz 0. omegax 2. omegay 0. omegaz -3.
fix		integr all nve/superquadric
thermo_style	custom step atoms
thermo		1000
thermo_modify	lost ignore norm no
run 1
write_dump all custom dump.F1 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 499 pre no
write_dump all custom dump.F500 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 500 pre no
write_dump all custom dump.F1000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 500 pre no
write_dump all custom dump.F1500 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 500 pre no
write_dump all custom dump.F2000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 1000 pre no
write_dump all custom dump.F3000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 1000 pre no
write_dump all custom dump.F4000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 1000 pre no
write_dump all custom dump.F5000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 1000 pre no
write_dump all custom dump.F6000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
run 2000 pre no
write_dump all custom dump.F8000 id x y z vx vy vz omegax omegay omegaz quat1 quat2 quat3 quat4 modify sort id
