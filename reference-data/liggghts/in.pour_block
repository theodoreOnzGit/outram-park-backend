# gh:#1414 insertion cross-code deck (generated by make_pour_decks.sh; see
# crates/outram-park-fork-liggghts/verification_and_validation/insertion/README.md).
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.035 0.035 -0.035 0.035 -0.005 0.35 units box
create_box	1 reg
neighbor	0.003 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
region		ins block -0.016 0.016 -0.016 0.016 0.05 0.3 units box
fix		pts all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.004
fix		pdd all particledistribution/discrete/numberbased 15485867 1 pts 1.0
fix		ins all insert/pack seed 32452843 distributiontemplate pdd insert_every 1000 overlapcheck yes all_in no random_distribute uncorrelated vel gaussian 0. 0. -0.1 0.03 0.03 0.03 omega constant 1. 2. 3. region ins mass_in_region 0.1
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
thermo_style	custom step atoms ke
thermo		1000
thermo_modify	lost ignore norm no
run 1
write_dump all custom dump.F1 id x y z vx vy vz omegax omegay omegaz modify sort id
run 999 pre no
write_dump all custom dump.F1000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1 pre no
write_dump all custom dump.F1001 id x y z vx vy vz omegax omegay omegaz modify sort id
run 5000 pre no
write_dump all custom dump.F6001 id x y z vx vy vz omegax omegay omegaz modify sort id
run 4000 pre no
write_dump all custom dump.F10001 id x y z vx vy vz omegax omegay omegaz modify sort id
run 9999 pre no
write_dump all custom dump.F20000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 4000 pre no
write_dump all custom dump.F24000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F26000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 4000 pre no
write_dump all custom dump.F30000 id x y z vx vy vz omegax omegay omegaz modify sort id
