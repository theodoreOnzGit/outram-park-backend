# gh:#1415 multisphere cross-code deck (generated by make_multisphere_decks.sh; see
# crates/outram-park-fork-liggghts/docs/verification-and-validation.md, section 4.16).
atom_style	granular
atom_modify	map array sort 0 0
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.05 0.05 -0.05 0.05 -0.005 0.15 units box
create_box	2 reg
neighbor	0.002 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 1.0e7 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 2 0.4 0.4 0.4 0.4
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	1e-5
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0 0 -1
fix		pts1 all particletemplate/multisphere 15485863 atom_type 1 density constant 2500 nspheres 3 ntry 100000 spheres 0. 0. 0. 0.004 0.005 0. 0.001 0.0035 0.002 0.004 -0.001 0.003 type 1
fix		pts2 all particletemplate/multisphere 49979687 atom_type 2 density constant 1500 nspheres 4 ntry 100000 spheres 0. 0. 0. 0.003 0.004 0.001 0. 0.003 -0.003 0.003 0.002 0.0025 0.001 -0.002 0.004 0.002 type 2
fix		pdd1 all particledistribution/discrete 15485867 1 pts1 1.0
fix		pdd2 all particledistribution/discrete 32452867 1 pts2 1.0
region		ins1 block -0.035 -0.025 -0.004 0.004 0.06 0.068 units box
region		ins2 block 0.025 0.035 -0.004 0.004 0.06 0.068 units box
fix		ins1 all insert/pack seed 32452843 distributiontemplate pdd1 insert_every once overlapcheck yes vel constant 0.6 0. 0. omega constant 0. 4. 0. region ins1 particles_in_region 1
fix		ins2 all insert/pack seed 86028121 distributiontemplate pdd2 insert_every once overlapcheck yes vel constant -0.6 0. 0. omega constant 2. 0. -3. orientation constant 0.5 0.5 -0.5 0.5 region ins2 particles_in_region 1
fix		ms all multisphere
thermo_style	custom step atoms
thermo		1000
thermo_modify	lost ignore norm no
run 1
write_dump all custom dump.F1 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1999 pre no
write_dump all custom dump.F2000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F4000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F6000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F8000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 2000 pre no
write_dump all custom dump.F10000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 100 pre no
write_dump all custom dump.F10100 id x y z vx vy vz omegax omegay omegaz modify sort id
fix_modify	ms fflag off on on
fix_modify	ms tflag on off on
run 100
write_dump all custom dump.F10200 id x y z vx vy vz omegax omegay omegaz modify sort id
run 800 pre no
write_dump all custom dump.F11000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1000 pre no
write_dump all custom dump.F12000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1000 pre no
