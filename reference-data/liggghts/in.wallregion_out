# fix wall/region on EXTERIOR (side out) regions (gh:#1491): 10 spheres (d = 10 mm)
# fall onto a horizontal side-out cylinder (axis y, radius 0.03, harmonic wall) and a
# side-out block shelf (lj93 wall) and bounce on a floor wall/gran at z = -0.12.
# thermo: step, then f_h f_h[1..3] f_a f_a[1..3] (energy and force on each wall).
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -1.0 1.0 -0.2 0.2 -0.13 0.3 units box
create_box	1 reg
neighbor	0.003 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	1e-5
fix		floor all wall/gran model hertz tangential history primitive type 1 zplane -0.12
region		rcyl cylinder y 0.0 0.0 0.03 -0.1 0.1 side out units box
region		rblk block -0.2 -0.06 -0.1 0.1 -0.08 -0.05 side out units box
create_atoms	1 single -0.012 -0.060 0.06 units box
create_atoms	1 single 0.004 -0.045 0.07 units box
create_atoms	1 single 0.018 -0.030 0.08 units box
create_atoms	1 single -0.025 -0.015 0.05 units box
create_atoms	1 single 0.030 0.000 0.065 units box
create_atoms	1 single -0.150 0.015 0.02 units box
create_atoms	1 single -0.120 0.030 0.03 units box
create_atoms	1 single -0.090 0.045 0.04 units box
create_atoms	1 single -0.075 0.060 0.01 units box
create_atoms	1 single -0.180 0.075 0.05 units box
set		atom 1 diameter 0.01 density 2500 vx 0.02 vz -0.3
set		atom 2 diameter 0.01 density 2500 vx -0.03 vz -0.5
set		atom 3 diameter 0.01 density 2500 vx 0.00 vz -0.2
set		atom 4 diameter 0.01 density 2500 vx 0.05 vz -0.4
set		atom 5 diameter 0.01 density 2500 vx -0.06 vz -0.1
set		atom 6 diameter 0.01 density 2500 vx 0.01 vz -0.6
set		atom 7 diameter 0.01 density 2500 vx -0.02 vz -0.3
set		atom 8 diameter 0.01 density 2500 vx 0.04 vz -0.5
set		atom 9 diameter 0.01 density 2500 vx -0.01 vz -0.2
set		atom 10 diameter 0.01 density 2500 vx 0.03 vz -0.4
fix		grav all gravity 9.81 vector 0 0 -1
fix		h all wall/region rcyl harmonic 200.0 0.0 0.005
fix		a all wall/region rblk lj93 1.0e-4 0.005 0.0043
fix		integr all nve/sphere
thermo_style	custom step f_h f_h[1] f_h[2] f_h[3] f_a f_a[1] f_a[2] f_a[3]
thermo_modify	lost ignore norm no format float %.17g
thermo		500
dump		d1 all custom 500 dump.wallregion_out id x y z vx vy vz omegax omegay omegaz fx fy fz
run		40000
