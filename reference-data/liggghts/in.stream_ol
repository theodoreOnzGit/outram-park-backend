# gh:#1414 insert/stream cross-code deck (generated by make_stream_decks.sh; see
# crates/outram-park-fork-liggghts/verification_and_validation/insertion/README.md).
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.035 0.035 -0.035 0.035 -0.005 0.35 units box
create_box	1 reg
neighbor	0.003 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		face all mesh/surface file stream_face.stl type 1
fix		pts all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.003
fix		pdd all particledistribution/discrete 15485867 1 pts 1.0
fix		ins all insert/stream seed 32452843 distributiontemplate pdd nparticles 200 particlerate 1000 overlapcheck yes vel uniform 0. 0. -1. 0.05 0.05 0.05 insertion_face face extrude_length 0.05
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
thermo_style	custom step atoms ke
thermo		1000
thermo_modify	lost ignore norm no
run 1
write_dump all custom dump.F1 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1 pre no
write_dump all custom dump.F2 id x y z vx vy vz omegax omegay omegaz modify sort id
run 4998 pre no
write_dump all custom dump.F5000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 5001 pre no
write_dump all custom dump.F10001 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1 pre no
write_dump all custom dump.F10002 id x y z vx vy vz omegax omegay omegaz modify sort id
run 1998 pre no
write_dump all custom dump.F12000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 8001 pre no
write_dump all custom dump.F20001 id x y z vx vy vz omegax omegay omegaz modify sort id
run 4999 pre no
write_dump all custom dump.F25000 id x y z vx vy vz omegax omegay omegaz modify sort id
run 5000 pre no
