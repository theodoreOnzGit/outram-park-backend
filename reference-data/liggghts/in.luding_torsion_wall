# luding rolling with torsion on against a z-plane wall (gh:#1410): spin about the wall normal as well.
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.2 0.2 -0.2 0.2 -0.05 0.4 units box
create_box	1 reg
neighbor	0.004 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 1.0e7
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix 		p0 all property/global LoadingStiffness peratomtypepair 1 1.0e4
fix 		p1 all property/global UnloadingStiffness peratomtypepair 1 3.0
fix 		p2 all property/global coefficientAdhesionStiffness peratomtypepair 1 0.4
fix 		p3 all property/global coefficientPlasticityDepth peratomtypepair 1 0.05
fix 		p4 all property/global pullOffForce peratomtypepair 1 0.001
fix 		p5 all property/global FluidViscosity peratomtypepair 1 0.8
fix 		p6 all property/global FrictionViscosity peratomtypepair 1 0.6
fix 		p7 all property/global coeffFrictionStiffness peratomtypepair 1 0.5
fix 		p8 all property/global coefficientRollingFriction peratomtypepair 1 0.1
fix 		p9 all property/global coefficientRollingViscousDamping peratomtypepair 1 0.3
fix 		pa all property/global coeffRollingStiffness peratomtypepair 1 0.5
pair_style	gran model luding tangential tan_luding rolling_friction luding torsion on
pair_coeff	* *
timestep	1e-6
fix		zwall all wall/gran model luding tangential tan_luding rolling_friction luding primitive type 1 zplane 0.0 torsion on
create_atoms	1 single 0.0 0.0 0.0053 units box
set		atom 1 diameter 0.01 density 2500 vx 0.6 vy 0.2 vz -0.8 omegay 30.0 omegaz 25.0
fix		integr all nve/sphere
thermo		1000
thermo_modify	lost ignore norm no
dump		d1 all custom 10 dump.luding_torsion_wall id x y z vx vy vz omegax omegay omegaz fx fy fz
run		2500
