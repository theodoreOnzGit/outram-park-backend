# gh:#1418 fix property/atom/tracer + compute nparticles/tracer/region cross-code deck
# (stream_ol feeding two tracers; see
# crates/outram-park-fork-liggghts/verification_and_validation/tracer/README.md).
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
region		reg block -0.035 0.035 -0.035 0.035 -0.005 0.35 units box
create_box	1 reg
neighbor	0.003 bin
neigh_modify	delay 0
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		face all mesh/surface file stream_face.stl type 1
fix		pts all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.003
fix		pdd all particledistribution/discrete 15485867 1 pts 1.0
fix		ins all insert/stream seed 32452843 distributiontemplate pdd nparticles 200 particlerate 1000 overlapcheck yes vel uniform 0. 0. -1. 0.05 0.05 0.05 insertion_face face extrude_length 0.05
fix		grav all gravity 9.81 vector 0 0 -1
fix		integr all nve/sphere
region		rm block -0.03 0.03 -0.03 0.03 0.06 0.12 units box
region		rc block -0.03 0.03 -0.03 0.03 -0.005 0.2 units box
fix		tr1 all property/atom/tracer region_mark rm mark_step 3 marker_style heaviside check_mark_every 7
fix		tr2 all property/atom/tracer region_mark rm mark_step 9001 marker_style dirac check_mark_every 10
compute		ntr1 all nparticles/tracer/region region_count rc tracer tr1 reset_marker yes
compute		ntr2 all nparticles/tracer/region region_count rc tracer tr2 reset_marker no
thermo_style	custom step atoms c_ntr1[1] c_ntr1[2] c_ntr1[3] c_ntr1[4] c_ntr2[1] c_ntr2[2] c_ntr2[3] c_ntr2[4] f_tr1 f_tr2
thermo_modify	format float %.17g
thermo		1000
thermo_modify	lost ignore norm no
dump		d all custom 5000 dump.tr id f_tr1 f_tr2
dump_modify	d sort id
run 40000
