# fix ave/spatial 1-d/2-d/3-d, norm all/sample, ave one/running/window (gh:#1418; generated by gen_avespatial.sh)
atom_style	granular
atom_modify	map array
boundary	f f f
newton		off
communicate	single vel yes
units		si
neighbor	0.003 bin
neigh_modify	delay 0
read_data	avetime_contact.data
fix 		m1 all property/global youngsModulus peratomtype 5.0e6
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.5
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
pair_style	gran model hertz tangential history
pair_coeff	* *
timestep	5e-6
fix		cyl all wall/gran model hertz tangential history primitive type 1 zcylinder 0.030 0. 0.
fix		zwall all wall/gran model hertz tangential history primitive type 1 zplane 0.0
fix		grav all gravity 9.81 vector 0.6 0 -0.8
fix		integr all nve/sphere

variable	xv atom x*vz
fix		s1 all ave/spatial 10 5 100 z lower 0.01 vx vy vz density/number density/mass v_xv norm all ave one
fix		s2 all ave/spatial 10 5 100 z lower 0.01 vz density/mass v_xv norm sample ave running
fix		s3 all ave/spatial 10 3 50 z lower 0.01 vx density/number norm sample ave window 2
fix		s4 all ave/spatial 10 5 100 z lower 0.01 x lower 1.0 vz density/number norm all ave one
fix		s5 all ave/spatial 10 5 100 z lower 0.01 x center 1.0 y lower 1.0 density/mass vx v_xv norm sample ave one
