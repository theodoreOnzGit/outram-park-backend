<?xml version="1.0"?>

<!--
Written for RAFFLES' `scram` port, not taken from upstream.

Of the Model Exchange Format's seven random deviates, upstream's own input
suite uses exactly two: `<lognormal-deviate>` in its three-argument form
(SmallTree, BSCU) and `<normal-deviate>` (Chinese). The other five appear
nowhere, so none of them could be checked against a model SCRAM ships. This
model uses all seven, and SCRAM supplies the answers.

What is being checked is each deviate's DETERMINISTIC value — upstream's
`value()`, the distribution's mean — which is what SCRAM's ordinary
(non-uncertainty) run computes and prints for every basic event. Sampling is
a separate matter and lands with the uncertainty analysis.

The gamma, beta and histogram deviates are used as the RATE of an
`<exponential>` rather than as a probability directly. That is not
presentation: upstream validates a basic event's expression with
`EnsureProbability`, which checks the expression's whole `interval()` against
[0, 1], and those three have domains that reach past 1. A rate only has to be
non-negative, which they are.

Hand-computed expectations, for the record (mission time 8760 h):

  u      uniform(0.1, 0.3)              -> 0.2
  n      normal(0.5, 0.01)              -> 0.5
  l3     lognormal(2e-5, 3, 0.95)       -> 2e-5 rate, p = 1 - exp(-0.1752)
  l2     lognormal(mu=-12, sigma=0.5)   -> exp(-12 + 0.125) rate
  g      gamma(k=2, theta=1e-6)         -> 2e-6 rate
  b      beta(alpha=1, beta=999)        -> 1e-3 rate... as a probability
  hist   histogram over three bins      -> weighted mean of the midpoints
-->

<opsa-mef>
  <define-fault-tree name="Deviates">
    <define-gate name="top">
      <and>
        <basic-event name="u"/>
        <basic-event name="n"/>
        <basic-event name="l3"/>
        <basic-event name="l2"/>
        <basic-event name="g"/>
        <basic-event name="b"/>
        <basic-event name="hist"/>
      </and>
    </define-gate>
  </define-fault-tree>

  <model-data>
    <define-basic-event name="u">
      <uniform-deviate>
        <float value="0.1"/>
        <float value="0.3"/>
      </uniform-deviate>
    </define-basic-event>

    <define-basic-event name="n">
      <normal-deviate>
        <float value="0.5"/>
        <float value="0.01"/>
      </normal-deviate>
    </define-basic-event>

    <define-basic-event name="l3">
      <exponential>
        <lognormal-deviate>
          <float value="2.0e-5"/>
          <float value="3"/>
          <float value="0.95"/>
        </lognormal-deviate>
        <system-mission-time/>
      </exponential>
    </define-basic-event>

    <define-basic-event name="l2">
      <exponential>
        <lognormal-deviate>
          <float value="-12"/>
          <float value="0.5"/>
        </lognormal-deviate>
        <system-mission-time/>
      </exponential>
    </define-basic-event>

    <define-basic-event name="g">
      <exponential>
        <gamma-deviate>
          <float value="2"/>
          <float value="1.0e-6"/>
        </gamma-deviate>
        <system-mission-time/>
      </exponential>
    </define-basic-event>

    <define-basic-event name="b">
      <exponential>
        <beta-deviate>
          <float value="1"/>
          <float value="999"/>
        </beta-deviate>
        <system-mission-time/>
      </exponential>
    </define-basic-event>

    <define-basic-event name="hist">
      <exponential>
        <histogram>
          <float value="0.0"/>
          <bin>
            <float value="1.0e-6"/>
            <float value="1.0"/>
          </bin>
          <bin>
            <float value="2.0e-6"/>
            <float value="3.0"/>
          </bin>
          <bin>
            <float value="5.0e-6"/>
            <float value="1.0"/>
          </bin>
        </histogram>
        <system-mission-time/>
      </exponential>
    </define-basic-event>
  </model-data>
</opsa-mef>
