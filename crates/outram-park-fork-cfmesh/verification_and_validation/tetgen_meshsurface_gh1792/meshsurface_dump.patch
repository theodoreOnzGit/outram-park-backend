+  fprintf(f, "randomseed %lu\n", randomseed);
+  fprintf(f, "insegments %ld\n", insegments);
+  fprintf(f, "minfacetdihed %016llx\n", bits(minfacetdihed));
+  fprintf(f, "flippool %ld\n", flippool->items);
+  fprintf(f, "rand %d\n", rand());
+  fclose(f);
+}
