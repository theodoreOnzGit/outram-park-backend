+#include <map>
+#include <string>
+// gh:#1792 instrumentation: the state right after meshsurface().
+static std::map<void*, long> poolmap(tetgenmesh::memorypool *pool) {
+  std::map<void*, long> m; long k = 0; void *it;
+  pool->traversalinit();
+  while ((it = pool->traverse()) != NULL) m[it] = k++;
+  return m;
+}
+static std::map<void*, long> g_sub, g_seg, g_tet, g_pt;
+static std::string shref(void *p) {
+  if (p == NULL) return "-";
+  uintptr_t u = (uintptr_t) p; int ver = (int) (u & 7); void *b = (void *) (u & ~(uintptr_t) 7);
+  char buf[64];
+  if (g_sub.count(b)) { snprintf(buf, 64, "f%ld.%d", g_sub[b], ver); return buf; }
+  if (g_seg.count(b)) { snprintf(buf, 64, "s%ld.%d", g_seg[b], ver); return buf; }
+  return "?";
+}
+static std::string tref(void *p) {
+  if (p == NULL) return "-";
+  uintptr_t u = (uintptr_t) p; int ver = (int) (u & 15); void *b = (void *) (u & ~(uintptr_t) 15);
+  char buf[64];
+  if (g_tet.count(b)) { snprintf(buf, 64, "t%ld.%d", g_tet[b], ver); return buf; }
+  return "?";
+}
+static std::string pref(tetgenmesh *m, void *p) {
+  char buf[32];
+  if (p == NULL) return "-";
+  if (p == (void *) m->dummypoint) return "D";
+  if (g_pt.count(p)) { snprintf(buf, 32, "%ld", g_pt[p]); return buf; }
+  return "?";
+}
+static unsigned long long bits(double x) { unsigned long long u; memcpy(&u, &x, 8); return u; }
