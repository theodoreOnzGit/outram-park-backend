+  while ((pp = (point) points->traverse()) != NULL) {
+    fprintf(f, "p %ld %d %d %d %016llx %016llx %016llx %s\n", k++, pointmark(pp), (int) pointtype(pp),
+      ((int *) pp)[pointmarkindex + 1] & 255, bits(pp[0]), bits(pp[1]), bits(pp[2]),
+      pointtype(pp) == DUPLICATEDVERTEX ? pref(this, point2ppt(pp)).c_str() : "-");
+  }
+  fprintf(f, "dummy %016llx %016llx %016llx\n", bits(dummypoint[0]), bits(dummypoint[1]), bits(dummypoint[2]));
