+      } else {
+        fprintf(f, "s %ld %s %s %s %d %d %s %s %s %s %s %s\n", k++,
+          pref(this, s[3]).c_str(), pref(this, s[4]).c_str(), pref(this, s[5]).c_str(),
+          shellmark(fc), ((int *) s)[shmarkindex + 1],
+          shref(s[0]).c_str(), shref(s[1]).c_str(), shref(s[2]).c_str(),
+          s[6] ? "x" : "-", tref(s[9]).c_str(), tref(s[10]).c_str());
+      }
+    }
+    fprintf(f, "%cdead", q ? 's' : 'f');
+    for (void *d = pool->deaditemstack; d != NULL; d = *(void **) d) fprintf(f, " %ld", (q ? g_seg : g_sub)[d]);
+    fprintf(f, "\n");
+  }
+  fprintf(f, "tets %ld %ld %ld\n", tetrahedrons->maxitems, tetrahedrons->items, hullsize);
+  tetrahedrons->traversalinit(); tetrahedron *t; k = 0;
