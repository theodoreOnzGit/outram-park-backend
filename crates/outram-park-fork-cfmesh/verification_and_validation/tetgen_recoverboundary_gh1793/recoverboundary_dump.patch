+    fprintf(f, "%s %ld %ld\n", names[q], pool->maxitems, pool->items);
+    pool->traversalinit(); shellface *s; k = 0;
+    while ((s = (shellface *) pool->traverse()) != NULL) {
+      if (s[3] == NULL) { fprintf(f, "%c %ld dead\n", q ? 's' : 'f', k++); continue; }
+      face fc; fc.sh = s; fc.shver = 0;
+      if (q == 0) {
+        fprintf(f, "f %ld %s %s %s %d %d %s %s %s %s %s %s %s %s\n", k++,
+          pref(this, s[3]).c_str(), pref(this, s[4]).c_str(), pref(this, s[5]).c_str(),
+          shellmark(fc), ((int *) s)[shmarkindex + 1],
+          shref(s[0]).c_str(), shref(s[1]).c_str(), shref(s[2]).c_str(),
