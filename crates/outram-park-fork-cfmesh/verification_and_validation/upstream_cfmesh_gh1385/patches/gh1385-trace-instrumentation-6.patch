+// gh:#1385 round 5 trace: GH1385_DUMP=<dir> writes the mesh points (17 digits) at the
+// named places of the meshOptimisation step
+static void gh1385Dump(const Foam::Module::polyMeshGen& mesh, const char* tag)
+{
+    const char* dir = getenv("GH1385_DUMP");
+    if (!dir) return;
+    const int call = 0;
+    char name[512];
+    snprintf(name, sizeof(name), "%s/%s_%d.txt", dir, tag, call);
+    FILE* f = fopen(name, "w");
+    const auto& pts = mesh.points();
+    for (Foam::label i = 0; i < pts.size(); ++i)
+        fprintf(f, "%.17g %.17g %.17g\n", pts[i].x(), pts[i].y(), pts[i].z());
+    fclose(f);
+}
