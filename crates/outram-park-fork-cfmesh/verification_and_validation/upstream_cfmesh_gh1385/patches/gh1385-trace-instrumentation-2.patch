+static void gh1385DumpAll(const char* tag, const Foam::Module::pointFieldPMG& pts)
+{
+    if (!getenv("GH1385_TRACE")) return;
+    for (Foam::label i = 0; i < pts.size(); ++i)
+        fprintf(stderr, "TRACE %s 0 %d %.17g %.17g %.17g\n", tag, int(i), pts[i].x(), pts[i].y(), pts[i].z());
+}
+
+static void gh1385DumpCells(const Foam::Module::cellListPMG& cells)
+{
+    if (!getenv("GH1385_TRACE")) return;
+    for (Foam::label c = 0; c < cells.size(); ++c)
+    {
+        fprintf(stderr, "CELL %d", int(c));
+        for (Foam::label i = 0; i < cells[c].size(); ++i) fprintf(stderr, " %d", int(cells[c][i]));
+        fprintf(stderr, "\n");
+    }
+}
