+static void gh1385Oct(const char* tag, Foam::Module::meshOctree& octree)
+{
+    if (!getenv("GH1385_TRACE")) return;
+    Foam::Module::meshOctreeModifier om(octree);
+    const Foam::Module::LongList<Foam::Module::meshOctreeCube*>& leaves = om.leavesAccess();
+    int hist[32] = {0};
+    for (Foam::label i = 0; i < leaves.size(); ++i) hist[int(leaves[i]->level())]++;
+    fprintf(stderr, "OCT %s leaves %d levels", tag, int(leaves.size()));
+    for (int l = 0; l < 32; ++l) if (hist[l]) fprintf(stderr, " %d:%d", l, hist[l]);
+    fprintf(stderr, "\n");
+}
