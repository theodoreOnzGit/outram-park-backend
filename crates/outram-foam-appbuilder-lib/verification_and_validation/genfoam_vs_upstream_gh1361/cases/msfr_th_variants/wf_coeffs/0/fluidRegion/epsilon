FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    topwall
    {
        type            epsilonWallFunction;
        kappa 0.4187;
	value           uniform 0.1;
    }
    bottomwall
    {
        type            epsilonWallFunction;
        Cmu 0.0845;
	value           uniform 0.1;
    }
    reflector
    {
        type            epsilonWallFunction;
        E 9.793;
        lowReCorrection on;
	value           uniform 0.1;
    }
    hx
    {
        type            epsilonWallFunction;
        Cmu 0.0845;
        kappa 0.4187;
        E 9.793;
	value           uniform 0.1;
    }
}

