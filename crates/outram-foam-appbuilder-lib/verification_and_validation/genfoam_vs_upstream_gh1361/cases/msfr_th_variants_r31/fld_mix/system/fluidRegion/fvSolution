FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance        1e-14;
        relTol           0;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol           0;
    }

    "e.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance        1e-14;
        relTol           0;
        minIter         0;
    }

    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance        1e-14;
        relTol           0;
        minIter         0;
    }

    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance        1e-14;
        relTol           0;
    }
}

PIMPLE
{
    solveEnergy                 true;
    solveFluidMechanics         true;
    nCorrectors                 6;
    nOuterCorrectors            5;
    nNonOrthogonalCorrectors    0;
    correctUntilConvergence     true;
    partialEliminationMode      implicit;
    momentumMode                cellCentered;
}

relaxationFactors
{
    fields
    {
        p_rgh           0.7;
        h               0.85;
    }
    equations
    {
        ".*"            0.9;
    }
}

