        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    walls
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    baffle0
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    baffle1
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
