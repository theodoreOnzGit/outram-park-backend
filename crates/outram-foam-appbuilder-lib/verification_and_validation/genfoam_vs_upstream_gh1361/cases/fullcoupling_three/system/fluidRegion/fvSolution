FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance        1e-14;
        relTol           0;
    }
    p_rghFinal
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance        1e-14;
        relTol           0;
    }
    "e.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance        1e-14;
        relTol           0;
        minIter         0;
    }
    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance        1e-14;
        relTol           0;
        minIter         0;
    }
    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance        1e-14;
        relTol           0;
    }
}

PIMPLE
{
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;
    solveEnergy         true;
    solveFluidMechanics true;
    nOuterCorrectors    3;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}


