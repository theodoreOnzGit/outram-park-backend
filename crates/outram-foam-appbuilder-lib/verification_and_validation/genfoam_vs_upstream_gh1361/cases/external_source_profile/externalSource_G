/*--------------------------------*- C++ -*----------------------------------*\
| Round 32b (gh:#1863): externalSource dictionary of the time-profile variant G |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      externalSource;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// G: the dictionary form of OpenFOAM's Function1 Table (`values`), no startTime, other knots.
// Real times: 1 until t = 10, up to 2.5 at t = 30, down to 0.5 at t = 50, hold.
externalSourceModulationTimeProfile
{
    type        table;
    values
    (
        (0      1)
        (10     1)
        (30     2.5)
        (50     0.5)
    );
}

