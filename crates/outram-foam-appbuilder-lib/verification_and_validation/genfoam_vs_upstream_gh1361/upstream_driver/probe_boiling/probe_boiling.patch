diff -ruN -x lnInclude -x 'linux64*' GeN-Foam-src/src/classes/thermalHydraulics/src/include/probe1361.H probe1361/classes/thermalHydraulics/src/include/probe1361.H
--- GeN-Foam-src/src/classes/thermalHydraulics/src/include/probe1361.H	1970-01-01 00:00:00.000000000 +0000
+++ probe1361/classes/thermalHydraulics/src/include/probe1361.H	2026-11-26 06:49:49.211989124 +0000
@@ -0,0 +1,39 @@
+// issue 1361 round 13 probe (scratch copy only): 17-digit dump of the intermediates of the boiling closures.
+#ifndef probe1361_H
+#define probe1361_H
+#include <cstdio>
+#include <cstdlib>
+namespace probe1361
+{
+    inline FILE* fp()
+    {
+        static FILE* f = nullptr;
+        static bool init = false;
+        if (!init)
+        {
+            init = true;
+            const char* n = std::getenv("PROBE1361_FILE");
+            if (n) f = std::fopen(n, "w");
+        }
+        return f;
+    }
+    inline long maxStep()
+    {
+        static long m = -1;
+        if (m < 0)
+        {
+            const char* s = std::getenv("PROBE1361_MAXSTEP");
+            m = s ? std::atol(s) : 1000000;
+        }
+        return m;
+    }
+    inline bool on(long step) { return fp() != nullptr && step <= maxStep(); }
+    inline long& callCounter() { static long c = 0; return c; }
+    inline void tag(const char* name, long step, long call, long cell)
+    {
+        std::fprintf(fp(), "%s step=%ld call=%ld cell=%ld", name, step, call, cell);
+    }
+    inline void kv(const char* k, double v) { std::fprintf(fp(), " %s=%.17g", k, v); }
+    inline void end() { std::fprintf(fp(), "\n"); }
+}
+#endif
