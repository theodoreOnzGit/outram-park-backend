diff -ruN -x lnInclude -x 'linux64*' GeN-Foam-src/src/classes/thermalHydraulics/solvers/twoPhase/probe1833.H probe1833/classes/thermalHydraulics/solvers/twoPhase/probe1833.H
--- GeN-Foam-src/src/classes/thermalHydraulics/solvers/twoPhase/probe1833.H	1970-01-01 00:00:00.000000000 +0000
+++ probe1833/classes/thermalHydraulics/solvers/twoPhase/probe1833.H	2026-11-26 14:04:37.652273143 +0000
@@ -0,0 +1,38 @@
+// gh:#1833 probe: 17-digit dumps of the face-centred two-phase pressure stage (instrumented copy, NOT upstream).
+#ifndef probe1833_H
+#define probe1833_H
+#include <fstream>
+#include <cstdlib>
+#include "fvCFD.H"
+namespace probe1833
+{
+    inline std::ofstream& os()
+    {
+        static std::ofstream f(std::getenv("PROBE1833_FILE") ? std::getenv("PROBE1833_FILE") : "/tmp/probe1833.txt");
+        static bool init(false);
+        if (!init) { f.precision(17); init = true; }
+        return f;
+    }
+    inline int& corr() { static int c(0); return c; }
+    inline bool on() { return corr() <= (std::getenv("PROBE1833_MAXCORR") ? std::atoi(std::getenv("PROBE1833_MAXCORR")) : 1); }
+    inline void dumpScalar(const char* name, const Foam::scalarField& f)
+    {
+        if (!on()) return;
+        os() << "S " << corr() << " " << name;
+        forAll(f, i) os() << " " << f[i];
+        os() << "\n";
+    }
+    inline void dumpVector(const char* name, const Foam::vectorField& f)
+    {
+        if (!on()) return;
+        os() << "V " << corr() << " " << name;
+        forAll(f, i) os() << " " << f[i].x() << " " << f[i].y() << " " << f[i].z();
+        os() << "\n";
+    }
+    //- internal faces only
+    inline void dumpFace(const char* name, const Foam::surfaceScalarField& f)
+    {
+        dumpScalar(name, f.primitiveField());
+    }
+}
+#endif
