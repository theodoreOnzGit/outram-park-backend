+// gh:#1894 probe: 17-digit dumps of the face-centred onePhase pressure stage (instrumented copy, NOT upstream).
+#ifndef probe1894_H
+#define probe1894_H
+#include <fstream>
+#include <cstdlib>
+#include "fvCFD.H"
+namespace probe1894
+{
+    inline std::ofstream& os()
+    {
+        static std::ofstream f(std::getenv("PROBE1894_FILE") ? std::getenv("PROBE1894_FILE") : "/tmp/probe1894.txt");
+        static bool init(false);
+        if (!init) { f.precision(17); init = true; }
+        return f;
+    }
+    inline int& corr() { static int c(0); return c; }
+    inline bool& active() { static bool a(false); return a; }
+    inline bool on() { return active() && corr() <= (std::getenv("PROBE1894_MAXCORR") ? std::atoi(std::getenv("PROBE1894_MAXCORR")) : 2); }
+    inline void dumpScalar(const char* name, const Foam::scalarField& f)
+    {
+        if (!on()) return;
+        os() << "S " << corr() << " " << name;
+        forAll(f, i) os() << " " << f[i];
+        os() << "\n";
+    }
+    inline void dumpVector(const char* name, const Foam::vectorField& f)
+    {
+        if (!on()) return;
+        os() << "V " << corr() << " " << name;
+        forAll(f, i) os() << " " << f[i].x() << " " << f[i].y() << " " << f[i].z();
+        os() << "\n";
+    }
+    inline void dumpFace(const char* name, const Foam::surfaceScalarField& f)
+    {
+        dumpScalar(name, f.primitiveField());
+    }
+    inline void dumpFaceB(const char* name, const Foam::surfaceScalarField& f)
+    {
+        Foam::scalarField all(0);
+        forAll(f.boundaryField(), pi)
+        {
+            const Foam::scalarField& v = f.boundaryField()[pi];
+            Foam::label o = all.size();
+            all.setSize(o + v.size());
+            forAll(v, i) all[o + i] = v[i];
+        }
+        dumpScalar(name, all);
+    }
+    inline void dumpVolB(const char* name, const Foam::volScalarField& f)
+    {
+        Foam::scalarField all(0);
+        forAll(f.boundaryField(), pi)
+        {
+            const Foam::scalarField& v = f.boundaryField()[pi];
+            Foam::label o = all.size();
+            all.setSize(o + v.size());
+            forAll(v, i) all[o + i] = v[i];
+        }
+        dumpScalar(name, all);
+    }
+    inline void dumpVolVecB(const char* name, const Foam::volVectorField& f)
+    {
+        Foam::vectorField all(0);
+        forAll(f.boundaryField(), pi)
+        {
+            const Foam::vectorField& v = f.boundaryField()[pi];
+            Foam::label o = all.size();
+            all.setSize(o + v.size());
+            forAll(v, i) all[o + i] = v[i];
+        }
+        dumpVector(name, all);
+    }
+    inline void dumpPatchVec(const char* name, const Foam::FieldField<Foam::Field, Foam::vector>& f)
+    {
+        Foam::vectorField all(0);
+        forAll(f, pi)
+        {
+            const Foam::vectorField& v = f[pi];
+            Foam::label o = all.size();
+            all.setSize(o + v.size());
+            forAll(v, i) all[o + i] = v[i];
+        }
+        dumpVector(name, all);
+    }
+    inline void dumpPatchScalar(const char* name, const Foam::FieldField<Foam::Field, Foam::scalar>& f)
+    {
+        Foam::scalarField all(0);
+        forAll(f, pi)
+        {
+            const Foam::scalarField& v = f[pi];
+            Foam::label o = all.size();
+            all.setSize(o + v.size());
+            forAll(v, i) all[o + i] = v[i];
+        }
+        dumpScalar(name, all);
+    }
+}
+#endif
