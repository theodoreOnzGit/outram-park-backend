+    fn probe_dump(&self, name: &str, v: &[f64]) {
+        use std::io::Write;
+        let path = match std::env::var("PORT_PROBE_FILE") {
+            Ok(p) => p,
+            Err(_) => return,
+        };
+        let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).expect("probe file");
+        let mut line = format!("S {} {}", PROBE_CORR.load(std::sync::atomic::Ordering::SeqCst), name);
+        for x in v {
+            line.push_str(&format!(" {:.17e}", x));
+        }
+        line.push('\n');
+        f.write_all(line.as_bytes()).expect("write");
+    }
+
