+// TEMPORARY gh:#1925 probe (never committed)
+fn pdump_s(corr: usize, name: &str, v: &[f64]) {
+    use std::io::Write;
+    let Ok(path) = std::env::var("PORT_PROBE_FILE") else { return };
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap();
+    let mut line = format!("S {corr} {name}");
+    for x in v {
+        line.push_str(&format!(" {:e}", x));
+    }
+    writeln!(f, "{line}").unwrap();
+}
+fn pdump_v(corr: usize, name: &str, v: &[Vector3]) {
+    use std::io::Write;
+    let Ok(path) = std::env::var("PORT_PROBE_FILE") else { return };
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap();
+    let mut line = format!("V {corr} {name}");
+    for x in v {
+        line.push_str(&format!(" {:e} {:e} {:e}", x.x, x.y, x.z));
+    }
+    writeln!(f, "{line}").unwrap();
+}
