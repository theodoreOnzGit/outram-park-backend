FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/fluid/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    left
    {
        type            patch;
        inGroups        1(viewFactorWall);
        nFaces          5;
        startFace       175;
    }
    interface
    {
        type            mappedWall;
        inGroups        3(wall mappedPatch viewFactorWall);
        nFaces          5;
        startFace       180;
        sampleMode      nearestPatchFace;
        sampleRegion    solid;
        samplePatch     interface;
    }
    walls
    {
        type            wall;
        inGroups        2(wall viewFactorWall);
        nFaces          40;
        startFace       185;
    }
    frontAndBack
    {
        type            wall;
        inGroups        2(wall viewFactorWall);
        nFaces          200;
        startFace       225;
    }
)

