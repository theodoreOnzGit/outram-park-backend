FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.6;

deltaT          0.005;

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

regionSolvers
{
    fluidRegion twoPhase;
}

removeBaffles
{
    fluidRegion false;
}

liquidFuel      false;

adjustTimeStep  true;

maxCo           5;

maxCoTwoPhase   0.5;

// ************************************************************************* //
