FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         12;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

writeContinuityErrors true;

adjustTimeStep  true;

maxDeltaT       0.01;

maxCo           2;

maxCoTwoPhase   0.25;

marginToPhaseChange 20;

regionSolvers
{
    fluidRegion     twoPhase;
}

removeBaffles
{
    fluidRegion     false;
}


