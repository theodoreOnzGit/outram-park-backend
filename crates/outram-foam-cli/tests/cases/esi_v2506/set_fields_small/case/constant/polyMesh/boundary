4
(
    left
    {
        type            patch;
        nFaces          2;
        startFace       7;
    }
    right
    {
        type            patch;
        nFaces          2;
        startFace       9;
    }
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          6;
        startFace       11;
    }
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
        nFaces          12;
        startFace       17;
    }
)

